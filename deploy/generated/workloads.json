    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "backend",
        "namespace": "demo"
      },
      "spec": {
        "ports": [
          {
            "name": "mtls",
            "port": 8443,
            "protocol": "TCP",
            "targetPort": 8443
          }
        ],
        "selector": {
          "app": "backend"
        },
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app": "backend"
        },
