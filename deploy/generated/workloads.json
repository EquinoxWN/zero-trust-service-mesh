        "namespace": "demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "backend"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "backend"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "-c",
                  "/etc/envoy/envoy.json",
                  "--log-level",
                  "info"
                ],
                "image": "docker.io/envoyproxy/envoy:v1.39.5@sha256:8fc594a5d85eb76dca24155cfb9208882406873932b20cf33649a0a611194c43",
                "name": "envoy",
                "ports": [
                  {
                    "containerPort": 8443,
                    "name": "mtls"
                  }
                ],
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsGroup": 101,
                  "runAsNonRoot": true,
                  "runAsUser": 101
                },
                "volumeMounts": [
                  {
                    "mountPath": "/etc/envoy",
                    "name": "envoy",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/envoy-admin",
                    "name": "envoy-admin"
                  },
                  {
                    "mountPath": "/run/spire/sockets",
                    "name": "spire-sockets",
                    "readOnly": true
                  }
                ]
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "backend",
            "volumes": [
              {
                "configMap": {
                  "name": "envoy-backend"
                },
                "name": "envoy"
              },
              {
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "1Mi"
                },
                "name": "envoy-admin"
              },
              {
                "hostPath": {
                  "path": "/run/spire/sockets",
                  "type": "Directory"
                },
                "name": "spire-sockets"
              }
            ]
          }
        }
      }
